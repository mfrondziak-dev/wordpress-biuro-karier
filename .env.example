# Skopiuj ten plik jako .env i uzupełnij wartości.
# Plik .env jest ignorowany przez git — nigdy go nie commituj.

# Publiczny adres strony (bez ukośnika na końcu).
WP_URL=https://kariera.example.com

# Hasła bazy danych — użyj długich, losowych wartości.
DB_PASSWORD=zmien-mnie-na-dlugie-haslo
DB_ROOT_PASSWORD=zmien-mnie-na-inne-dlugie-haslo

# Konto administratora WordPress.
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=zmien-mnie-na-dlugie-haslo
WP_ADMIN_EMAIL=admin@example.com
